rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid &&
             data.anonymousName is string && data.anonymousName.size() >= 2 && data.anonymousName.size() <= 40 &&
             data.anonymousAvatar is string && data.anonymousAvatar.size() >= 1 &&
             (!('displayName' in data) || data.displayName is string) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 200)) &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidPost(data) {
      return data.postId is string && data.postId.size() >= 1 &&
             data.authorId is string && data.authorId.size() >= 1 &&
             data.anonymousName is string && data.anonymousName.size() >= 2 && data.anonymousName.size() <= 40 &&
             data.anonymousAvatar is string && data.anonymousAvatar.size() >= 1 &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 2000 &&
             (!('contentWarning' in data) || (data.contentWarning is string && data.contentWarning.size() <= 60)) &&
             (!('commentsEnabled' in data) || data.commentsEnabled is bool) &&
             (!('reactionsEnabled' in data) || data.reactionsEnabled is bool) &&
             (!('reactionCount' in data) || data.reactionCount is int) &&
             (!('commentCount' in data) || data.commentCount is int) &&
             (!('saveCount' in data) || data.saveCount is int) &&
             (!('isArchived' in data) || data.isArchived is bool) &&
             (!('isDeleted' in data) || data.isDeleted is bool) &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt)) &&
             (!('updatedAt' in data) || isValidTimestamp(data.updatedAt));
    }

    function isValidComment(data) {
      return data.commentId is string && data.commentId.size() >= 1 &&
             data.postId is string && data.postId.size() >= 1 &&
             data.authorId is string && data.authorId == request.auth.uid &&
             data.anonymousName is string && data.anonymousName.size() >= 2 && data.anonymousName.size() <= 40 &&
             data.content is string && data.content.size() >= 1 && data.content.size() <= 600 &&
             (!('anonymousAvatar' in data) || data.anonymousAvatar is string) &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    function isValidReaction(data) {
      return data.reactionId is string && data.reactionId.size() >= 1 &&
             data.postId is string && data.postId.size() >= 1 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.reactionType in ['love', 'sad', 'funny', 'wow', 'angry', 'relatable'] &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    function isValidSavedPost(data) {
      return data.saveId is string && data.saveId.size() >= 1 &&
             data.userId is string && data.userId == request.auth.uid &&
             data.postId is string && data.postId.size() >= 1 &&
             (!('savedAt' in data) || isValidTimestamp(data.savedAt));
    }

    function isValidReport(data) {
      return data.reportId is string && data.reportId.size() >= 1 &&
             data.reporterId is string && data.reporterId == request.auth.uid &&
             data.targetType in ['post', 'comment'] &&
             data.targetId is string && data.targetId.size() >= 1 &&
             data.reason is string && data.reason.size() >= 3 && data.reason.size() <= 300 &&
             (!('createdAt' in data) || isValidTimestamp(data.createdAt));
    }

    // User profile matching auth UID
    match /users/{userId} {
      allow read, write: if isOwner(userId) && isValidUserProfile(request.resource.data);
      allow get: if isOwner(userId);

      match /saved_posts/{saveId} {
        allow read, write: if isOwner(userId) && isValidSavedPost(request.resource.data);
        allow delete: if isOwner(userId);
      }
    }

    // Confessions & stories
    match /posts/{postId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() &&
                      request.resource.data.authorId == request.auth.uid &&
                      isValidPost(request.resource.data);
      allow update: if isAuthenticated() &&
                      (resource.data.authorId == request.auth.uid ||
                       request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactionCount', 'commentCount', 'saveCount', 'updatedAt'])) &&
                      isValidPost(request.resource.data);
      allow delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if isAuthenticated();
        allow create: if isAuthenticated() &&
                        request.resource.data.authorId == request.auth.uid &&
                        isValidComment(request.resource.data);
        allow update, delete: if isAuthenticated() && resource.data.authorId == request.auth.uid;
      }

      match /reactions/{reactionId} {
        allow read: if isAuthenticated();
        allow create, update: if isAuthenticated() &&
                                request.resource.data.userId == request.auth.uid &&
                                isValidReaction(request.resource.data);
        allow delete: if isAuthenticated() && resource.data.userId == request.auth.uid;
      }
    }

    match /reports/{reportId} {
      allow create: if isAuthenticated() &&
                      request.resource.data.reporterId == request.auth.uid &&
                      isValidReport(request.resource.data);
      allow read, update, delete: if false;
    }
  }
}
